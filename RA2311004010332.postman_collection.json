    {
      "name": "03 Local Backend - Notifications",
      "item": [
        {
          "name": "Get All Notifications (Paginated)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{localBaseUrl}}/api/notification?page=1&limit=20",
              "host": [
                "{{localBaseUrl}}"
              ],
              "path": [
                "api",
                "notification"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        },
