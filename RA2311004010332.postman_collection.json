        {
          "name": "Create Notification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentID\": 1,\n  \"type\": \"Result\",\n  \"message\": \"Your result has been published\",\n  \"priority\": 8\n}"
            },
            "url": {
              "raw": "{{localBaseUrl}}/api/notification",
              "host": [
                "{{localBaseUrl}}"
              ],
              "path": [
                "api",
                "notification"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var json = pm.response.json();",
                  "if (json && json.data && json.data.id) {",
                  "  pm.environment.set('notificationId', json.data.id);",
                  "}"
                ]
              }
            }
          ]
        },
